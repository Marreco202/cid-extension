{
  "name": "cid",
  "displayName": "CID",
  "description": "Open source copilot for understanding repositories",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.102.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "cid.helloWorld",
        "title": "CID : Open Chat",
        "icon": "$(comment-discussion)"
      },
      {
        "command": "cid.listWorkspaceFiles",
        "title": "CID : List Workspace Files"
      },
      {
        "command": "cid.explainCurrentFile",
        "title": "CID : Explain Current File"
      },
      {
        "command": "cid.analyzePythonFiles",
        "title": "CID : List all functions on project"
      },
      {
        "command": "cid.renderMermaid",
        "title": "CID : Render Mermaid File on Webview"
      },
      {
        "command": "cid.generateAndShowMermaidMOCK",
        "title": "CID: Generate and Show Mermaid for Project - MOCK"
      },
      {
        "command": "cid.generateAndShowMermaid",
        "title": "CID: Generate and Show Mermaid for Project"
      },
      {
        "command": "cid.testingGemini",
        "title": "CID: Test Gemini Connection"
      },
      {
        "command": "cid.printReadMe",
        "title": "CID: Find and Console Log README.md"
      }
    ],
    "views": {
      "cid-container": [
        {
          "id": "cid.functionsView",
          "name": "Funções CID",
          "icon": "media/smile.svg"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "cid.helloWorld",
          "when": "view === cid.functionsView",
          "group": "navigation"
        }
      ]
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "cid-container",
          "title": "CID Assistant",
          "icon": "media/smile.svg"
        }
      ]
    },
    "activities": {
      "id": "cid-activity",
      "viewsContainersId": "cid-container",
      "title": "CID Assistant",
      "icon": "media/icon.svg"
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^20.19.11",
    "@types/vscode": "^1.102.0",
    "@typescript-eslint/eslint-plugin": "^8.31.1",
    "@typescript-eslint/parser": "^8.31.1",
    "@vscode/test-cli": "^0.0.11",
    "@vscode/test-electron": "^2.5.2",
    "eslint": "^9.25.1",
    "typescript": "^5.8.3"
  },
  "dependencies": {
    "@google/genai": "^1.25.0",
    "@panzoom/panzoom": "^4.6.0",
    "dotenv": "^17.2.3",
    "mermaid": "^11.12.0",
    "ollama": "^0.5.16"
  }
}
