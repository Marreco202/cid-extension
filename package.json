{
  "name": "companion-in-development",
  "displayName": "CiD (Companion in Development)",
  "description": "Open source copilot for understanding repositories",
  "version": "0.0.1",
  "publisher": "marreco",
  "repository": {
    "type": "git",
    "url": "https://github.com/Marreco202/cid-extension"
  },
  "license": "MIT",
  "engines": {
    "vscode": "^1.102.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "ai",
    "copilot",
    "code-assistant",
    "mermaid",
    "gemini",
    "ollama",
    "openai",
    "vscode-extension",
    "typescript"
  ],
  "activationEvents": [],
  "main": "./out/extension.js",
  "contributes": {

    "configuration": {
      "title": "CiD (Companion in Development)",
      "properties": {
        "cid.modelProvider": {
          "type": "string",
          "enum": ["Ollama","Gemini","GPT"],
          "default": "Ollama",
          "description": "Select the model family/AI provider that the CID Assistant should use."
        },

        "cid.modelName" : {
          "type" : "string",
          "default" : "gemma4:e4b",
          "description": "Select the exact model that you're using (e.g. 'gemma4:e4b' for Ollama or 'gemini-1.5-flash' for Gemini)."
        }
      }
    },

    "commands": [
      {
        "command": "cid.helloWorld",
        "title": "CID : Open Chat",
        "icon": "$(comment-discussion)"
      },
      {
        "command": "cid.listWorkspaceFiles",
        "title": "CID : List Workspace Files"
      },
      {
        "command": "cid.explainCurrentFile",
        "title": "CID : Explain Current File"
      },
      {
        "command": "cid.analyzePythonFiles",
        "title": "CID : List all functions on project"
      },
      {
        "command": "cid.renderMermaid",
        "title": "CID : Render Mermaid File on Webview"
      },
      {
        "command": "cid.generateAndShowMermaidMOCK",
        "title": "CID: Generate and Show Mermaid for Project - MOCK"
      },
      {
        "command": "cid.generateAndShowMermaid",
        "title": "CID: Generate and Show Mermaid for Project",
        "icon" : "$(type-hierarchy)"
      },
      {
        "command": "cid.testingGemini",
        "title": "CID: Test Gemini Connection"
      },
      {
        "command": "cid.printReadMe",
        "title": "CID: Find and Console Log README.md"
      },
      {
        "command": "cid.setApiKey",
        "title": "CID: Set API Key"
      },
      {
        "command": "cid.clearAllApiKeys",
        "title": "CID: Clear All Saved API Keys"
      },
      {
        "command": "cid.openSettings",
        "title": "CID: Open Settings",
        "icon": "$(settings-gear)"
      }
    ],
    "views": {
      "cid-container": [
        {
          "id": "cid.functionsView",
          "name": "Funções CID",
          "icon": "media/smile.png"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "cid.helloWorld",
          "when": "view === cid.functionsView",
          "group": "navigation"
        },

        {
          "command": "cid.generateAndShowMermaid",
          "when": "view == cid.functionsView",
          "group": "navigation"
        },

        {
          "command": "cid.openSettings",
          "when": "view == cid.functionsView",
          "group": "navigation@2"
        }
      ]
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "cid-container",
          "title": "CID Assistant",
          "icon": "media/smile.png"
        }
      ]
    },
    "activities": {
      "id": "cid-activity",
      "viewsContainersId": "cid-container",
      "title": "CID Assistant",
      "icon": "media/icon.svg"
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^20.19.11",
    "@types/vscode": "^1.102.0",
    "@typescript-eslint/eslint-plugin": "^8.31.1",
    "@typescript-eslint/parser": "^8.31.1",
    "@vscode/test-cli": "^0.0.11",
    "@vscode/test-electron": "^2.5.2",
    "eslint": "^9.25.1",
    "typescript": "^5.8.3"
  },
  "dependencies": {
    "@google/genai": "^1.25.0",
    "@panzoom/panzoom": "^4.6.0",
    "dotenv": "^17.2.3",
    "mermaid": "^11.12.0",
    "ollama": "^0.5.16",
    "openai": "^6.6.0"
  }
}
